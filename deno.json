{
  "name": "@adviser/ovn-fabric",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "nodeModulesDir": "none",
  "exports": {
    ".": "./src/mod.ts",
    "./cli": "./src/cli.ts"
  },
  "imports": {
    "jsr:@adviser/ovn-fabric": "./src/mod.ts",
    "jsr:@adviser/ovn-fabric/cli": "./src/cli.ts",
    "arktype": "npm:arktype@^2.1.0",
    "fnv1a": "npm:fnv1a@^1.1.1"
  },
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": ["jsr:@adviser/ipaddress"]
  },
  "tasks": {
    "check": "deno check src/*.ts",
    "test": "deno test --allow-read --allow-env src/*_test.ts",
    "fmt": "deno fmt",
    "fmt-check": "deno fmt --check",
    "lint": "deno lint"
  },
  "fmt": {
    "include": ["src/**/*.ts", "examples/**/*.ts"]
  },
  "lint": {
    "include": ["src/**/*.ts", "examples/**/*.ts"],
    "rules": {
      "exclude": ["no-import-prefix"]
    }
  },
  "publish": {
    "include": ["src/**/*.ts", "README.md", "LICENSE"],
    "exclude": ["src/*_test.ts"]
  }
}
